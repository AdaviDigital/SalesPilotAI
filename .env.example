# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Standard PostgreSQL connection string. Works with Neon, Supabase, Render
# Postgres, Railway, Hostinger-compatible Postgres, or self-hosted.
DATABASE_URL=postgresql://user:password@localhost:5432/salespilot

# Generate strong random values, e.g.: openssl rand -base64 48
JWT_SECRET=
SESSION_SECRET=

APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# ── AI Provider ─────────────────────────────────────────────────────────
# One of: openai | anthropic | google | none
# Leave as "none" and the app runs fully with AI features in demo mode.
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ── Storage ─────────────────────────────────────────────────────────────
# One of: local | s3
# "local" writes to ./server/uploads — use only for development.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Email (transactional: verification, password reset, notifications) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Billing ─────────────────────────────────────────────────────────────
# One of: stripe | paystack | flutterwave | none
BILLING_PROVIDER=none
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
